    "HelpInfoModal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hilfe-Bereich\nHier erfahren Sie, wie die einzelnen Komponenten funktionieren.\nKlicken Sie einfach auf eine Komponente, um mehr zu erfahren.\n\nTippen Sie auf das Podbike-Logo, um Statistiken anzuzeigen.\n\n\nAchtung! Diese Symbole werden bald in Warnsymbole umgewandelt, die Ihnen einen Einblick in ihre Funktionsweise geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help Section\nHere you can explore the dashboard. Click on any component to learn more.\n\nTap on the Podbike logo to see Statistics.\n\nHeads up: The top buttons will now change to warning icons to present their functionality."
          }
        }
      }
    },
    "HelpLightAlert" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scheinwerfer\nDieses Symbol leuchtet auf, wenn ein Problem mit den Scheinwerfern vorliegt, z. B. eine Störung oder ein Ausfall"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headlights\nThis symbol lights up to indicate a problem with the headlights, such as a malfunction or failure"
          }
        }
      }
    },
    "HelpModeAndLights" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modus und Lichter\nAbblend- oder Fernlichtanzeige und eine Stelle zur Anzeige des Verbindungsmodus, z. B. Bluetooth-Trennung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode and Lights\nLow beam or high beam indicator and a place to display connection mode, e.g. Bluetooth disconnection "
          }
        }
      }
    },
