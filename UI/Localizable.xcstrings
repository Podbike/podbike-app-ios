    "FrikarNotFound" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Moment bitte. Die Verbindung zum FRIKAR wird hergestellt. Wenn Ihr FRIKAR nicht gefunden wird, wählen Sie bitte 'NACH FRIKAR SUCHEN', um ein anderes FRIKAR zu verbinden. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please wait a moment to establish a connection with the FRIKAR. If your FRIKAR cannot be found, then press 'SCAN FOR FRIKAR' to choose another FRIKAR."
          }
        }
      }
    },
